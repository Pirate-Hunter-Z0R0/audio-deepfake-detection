# ==============================================================================
# Git Ignore Rules for Audio Deepfake Detection Project
# ==============================================================================

# Virtual Environments (DO NOT COMMIT - 2+ GB of local compiled binaries)
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Large Audio Datasets (Exceeds GitHub 100MB limit - 5+ GB total)
data/raw/
data/processed/

# Keep data directory structure intact with .gitkeep
!data/
!data/features/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cloned_samples/.gitkeep

# Keep small custom test samples / metadata
data/cloned_samples/*.wav
!data/cloned_samples/.gitkeep

# Temporary / Upload directories
app/static/uploads/*
!app/static/uploads/.gitkeep

# Distribution / Packaging
build/
dist/
*.egg-info/

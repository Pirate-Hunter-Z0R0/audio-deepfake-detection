# ==============================================================================
# Git Ignore Rules for Audio Deepfake Detection Project
# ==============================================================================

# Virtual Environments (DO NOT COMMIT - 2+ GB of local compiled binaries)
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Large Audio Datasets (Exceeds GitHub 100MB limit - 5+ GB total)
data/raw/
data/processed/
data/raw_training_audio/
data/real_recordings/
data/synthetic_rvc/
data/temp/
data/*.zip
*.zip
*.tar.gz

# Large Extracted Feature Matrices (> 80MB total, recreate via python src/feature_extraction.py)
data/features/*.csv
data/features/*.npy
!data/features/.gitkeep

# Keep data directory structure intact with .gitkeep
!data/
!data/features/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cloned_samples/.gitkeep

# Keep small custom test samples / metadata
data/cloned_samples/*.wav
!data/cloned_samples/.gitkeep

# Temporary / Upload directories
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/clones/*
!app/static/clones/.gitkeep

# Large Weights, Checkpoints & RVC Voice Models (> 50MB-100MB)
models/rvc_voices/
*.pth
*.weights.h5
*.index

# Local Scratch, IDE & Extracted Assets
.vscode/
extracted_doc_images/
extracted_nie_images/
scratch_*.py

# Distribution / Packaging
build/
dist/
*.egg-info/
